# ============================================================
# Coolify — variáveis (copie para o painel / .env da stack)
# ============================================================

# ---- Postgres (VPS) ----
POSTGRES_USER=wacrm
POSTGRES_PASSWORD=troque-esta-senha-forte
POSTGRES_DB=wacrm
POSTGRES_HOST_PORT=5432

# String usada por scripts e pelo app (rede interna Coolify: host = nome do serviço `db`)
DATABASE_URL=postgresql://wacrm:troque-esta-senha-forte@db:5432/wacrm

# ---- App ----
HOST_PORT=3000
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br
NEXT_PUBLIC_APP_LOCALE=pt-BR

# Auth/API compat (self-hosted GoTrue+PostgREST OU stack Supabase self-hosted).
# NÃO use supabase.co em produção se o banco é só na VPS —
# aponte para a URL pública do seu Kong/API na mesma VPS.
NEXT_PUBLIC_SUPABASE_URL=https://api.seu-dominio.com.br
NEXT_PUBLIC_SUPABASE_ANON_KEY=gere-um-jwt-anon-com-o-mesmo-JWT_SECRET
SUPABASE_SERVICE_ROLE_KEY=gere-um-jwt-service-role-com-o-mesmo-JWT_SECRET

# JWT compartilhado entre GoTrue / PostgREST / app (mín. 32 chars)
JWT_SECRET=troque-por-um-segredo-longo-de-pelo-menos-32-caracteres

ENCRYPTION_KEY=
META_APP_SECRET=

PLATFORM_ADMIN_EMAILS=voce@exemplo.com
NEXT_PUBLIC_PLATFORM_ADMIN_EMAILS=voce@exemplo.com

ASAAS_API_KEY=
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_WEBHOOK_TOKEN=

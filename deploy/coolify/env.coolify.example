# ============================================================
# Coolify — variáveis (copie para o painel / .env da stack)
# ============================================================
# Onda A (atual): app no Coolify + Auth/dados no Supabase Cloud.
# Onda D: migrar NEXT_PUBLIC_SUPABASE_* para API self-hosted na VPS.
# ============================================================

# ---- Postgres Coolify (wacrm-db) — reservado até Onda D ----
POSTGRES_USER=wacrm
POSTGRES_PASSWORD=troque-esta-senha-forte
POSTGRES_DB=wacrm
POSTGRES_HOST_PORT=5432

# Opcional na Onda A (runtime do Next não usa). Útil para migrations / Onda D.
DATABASE_URL=postgresql://wacrm:troque-esta-senha-forte@wacrm-db:5432/wacrm

# ---- App ----
HOST_PORT=3000
NEXT_PUBLIC_SITE_URL=https://crm.euapoio.cloud
NEXT_PUBLIC_APP_LOCALE=pt-BR

# Onda A: projeto Supabase Cloud (Auth + REST/RLS).
# Onda D: URL pública do Kong/GoTrue+PostgREST na mesma VPS.
NEXT_PUBLIC_SUPABASE_URL=https://SEU_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Só necessário quando Auth for self-hosted (Onda D)
JWT_SECRET=troque-por-um-segredo-longo-de-pelo-menos-32-caracteres

ENCRYPTION_KEY=
META_APP_SECRET=

PLATFORM_ADMIN_EMAILS=voce@exemplo.com
NEXT_PUBLIC_PLATFORM_ADMIN_EMAILS=voce@exemplo.com

ASAAS_API_KEY=
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_WEBHOOK_TOKEN=

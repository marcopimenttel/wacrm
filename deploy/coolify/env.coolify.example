# ============================================================
# Coolify — variáveis (app + referência Onda D)
# ============================================================

# ---- App (produção atual = Cloud) ----
HOST_PORT=3000
NEXT_PUBLIC_SITE_URL=https://crm.euapoio.cloud
NEXT_PUBLIC_APP_LOCALE=pt-BR

NEXT_PUBLIC_SUPABASE_URL=https://SEU_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

ENCRYPTION_KEY=
META_APP_SECRET=
PLATFORM_ADMIN_EMAILS=voce@exemplo.com
NEXT_PUBLIC_PLATFORM_ADMIN_EMAILS=voce@exemplo.com

ASAAS_API_KEY=
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_WEBHOOK_TOKEN=

# ---- Postgres VPS (wacrm-db) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha-forte
POSTGRES_DB=postgres
DATABASE_URL=postgresql://postgres:troque-esta-senha-forte@wacrm-db:5432/postgres

# ---- Onda D (resource wacrm-api) — ver deploy/coolify/onda-d/.env.example ----
# Gere: node scripts/generate-supabase-keys.mjs
# JWT_SECRET=
# ANON_KEY=
# SERVICE_ROLE_KEY=
# SECRET_KEY_BASE=
# API_EXTERNAL_URL=https://api.crm.euapoio.cloud
#
# Depois do cutover, no APP:
# NEXT_PUBLIC_SUPABASE_URL=https://api.crm.euapoio.cloud
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<ANON_KEY>
# SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY>

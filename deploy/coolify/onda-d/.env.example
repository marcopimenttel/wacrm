# ============================================================
# Onda D — env do resource Coolify "Docker Compose" (wacrm-api)
# ============================================================

# Postgres Coolify (hostname = UUID interno do resource wacrm-db, NÃO o nome amigável)
# Ex.: lu1fp0hmhzgn5gusipz4fx2r — copie de wacrm-db → General → Postgres URL (internal)
POSTGRES_HOST=lu1fp0hmhzgn5gusipz4fx2r
POSTGRES_PORT=5432
# Coolify criou o DB inicial como "wacrm" (não use "postgres" aqui)
POSTGRES_DB=wacrm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=a-mesma-senha-do-wacrm-db

# URLs públicas
SITE_URL=https://crm.euapoio.cloud
API_EXTERNAL_URL=https://apicrm.euapoio.cloud
GATEWAY_HOST_PORT=8000

# Gere com: node scripts/generate-supabase-keys.mjs
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
SECRET_KEY_BASE=
JWT_EXPIRY=3600

# Auth
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ADDITIONAL_REDIRECT_URLS=https://crm.euapoio.cloud/**

# SMTP opcional (senão só magic-link/autoconfirm)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=noreply@euapoio.cloud
SMTP_SENDER_NAME=WACRM

PGRST_DB_SCHEMAS=public,storage
REALTIME_DB_ENC_KEY=supabaserealtime

# Gateway Caddy — API estilo Supabase (/auth/v1, /rest/v1, /realtime/v1, /storage/v1)
# Coolify/Traefik usa porta 80 por padrão no domínio do serviço.
{
	admin off
}

:80 {
	@preflight {
		method OPTIONS
	}
	handle @preflight {
		header Access-Control-Allow-Origin "{header.origin}"
		header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		header Access-Control-Allow-Headers "authorization, apikey, content-type, x-client-info, x-supabase-api-version, accept, prefer, x-supabase-auth"
		header Access-Control-Allow-Credentials "true"
		header Access-Control-Max-Age "86400"
		respond 204
	}
	header Access-Control-Allow-Origin "{header.origin}"
	header Access-Control-Allow-Credentials "true"
	header Access-Control-Expose-Headers "content-range, x-supabase-api-version"

	handle_path /auth/v1/* {
		reverse_proxy auth:9999 {
			header_down -Access-Control-Allow-Origin
			header_down -Access-Control-Allow-Credentials
			header_down -Access-Control-Allow-Headers
			header_down -Access-Control-Allow-Methods
			header_down -Access-Control-Expose-Headers
		}
	}

	handle_path /rest/v1/* {
		reverse_proxy rest:3000 {
			header_down -Access-Control-Allow-Origin
			header_down -Access-Control-Allow-Credentials
			header_down -Access-Control-Allow-Headers
			header_down -Access-Control-Allow-Methods
			header_down -Access-Control-Expose-Headers
		}
	}

	# Cliente JS usa /realtime/v1/websocket → Phoenix em /socket/websocket
	handle_path /realtime/v1/* {
		rewrite * /socket{uri}
		reverse_proxy realtime:4000 {
			header_down -Access-Control-Allow-Origin
			header_down -Access-Control-Allow-Credentials
			header_down -Access-Control-Allow-Headers
			header_down -Access-Control-Allow-Methods
			header_down -Access-Control-Expose-Headers
		}
	}

	handle_path /storage/v1/* {
		reverse_proxy storage:5000 {
			header_down -Access-Control-Allow-Origin
			header_down -Access-Control-Allow-Credentials
			header_down -Access-Control-Allow-Headers
			header_down -Access-Control-Allow-Methods
			header_down -Access-Control-Expose-Headers
		}
	}

	handle /health {
		respond "ok" 200
	}

	handle {
		respond "WACRM API — /auth/v1 /rest/v1 /realtime/v1 /storage/v1" 404
	}
}
